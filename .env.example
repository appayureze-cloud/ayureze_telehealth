###############################################################################
# AyurEze Telehealth — Environment Configuration Template
#
# Copy this file to `.env` at the repository root and fill in real values.
# NEVER commit the resulting `.env` file. See .gitignore.
#
# All secrets below are placeholders. Generate strong, unique values for
# every deployment (local dev, staging, production) — do not reuse across
# environments.
###############################################################################

# --- General ---
ENVIRONMENT=development
LOG_LEVEL=info
TZ=UTC

# --- PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ayureze_telehealth
POSTGRES_USER=ayureze
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_SSLMODE=disable
# Full DSN used by the Go API (derived from the above if unset)
DATABASE_URL=postgres://ayureze:change-me-strong-password@postgres:5432/ayureze_telehealth?sslmode=disable

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me-redis-password
REDIS_DB=0

# --- LiveKit ---
# Generate with: docker run --rm livekit/livekit-server generate-keys
LIVEKIT_API_KEY=devkey_changeme
LIVEKIT_API_SECRET=change-me-livekit-secret-min-32-chars
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_HTTP_PORT=7880
LIVEKIT_RTC_TCP_PORT=7881
LIVEKIT_RTC_UDP_PORT_RANGE_START=50000
LIVEKIT_RTC_UDP_PORT_RANGE_END=50100
# Single-machine local dev only — see infrastructure/livekit/livekit.yaml.
LIVEKIT_NODE_IP=127.0.0.1
# Production (a VPS with a static public IP — see docs/deployment/
# turn-verification.md's "Production topology"): set to "true" AND set
# LIVEKIT_NODE_IP above to that VPS's real public IP. Leave "false" for
# local dev (default) — do not flip this without a real public IP to put
# in LIVEKIT_NODE_IP, or LiveKit will advertise an unreachable address.
LIVEKIT_USE_EXTERNAL_IP=false

# --- Coturn (TURN/STUN) ---
TURN_REALM=ayureze.local
TURN_LISTEN_PORT=3478
# Not currently wired up (no cert/key configured, no --tls-listening-port
# passed) — see docs/deployment/turn-verification.md's "TLS/TCP note" for
# why this is a known, documented gap rather than silently implemented or
# silently ignored.
TURN_TLS_LISTEN_PORT=5349
TURN_MIN_PORT=49160
TURN_MAX_PORT=49200
TURN_STATIC_AUTH_SECRET=change-me-turn-shared-secret
TURN_USERNAME=ayureze
TURN_PASSWORD=change-me-turn-password
# Production only (coturn running in Docker on a VPS — the normal case):
# set to that VPS's real public IP, so coturn reports a reachable relay
# address instead of its internal Docker network IP. Leave unset for
# local dev (default) — see docs/deployment/turn-verification.md.
COTURN_EXTERNAL_IP=

# --- Go API service ---
API_HTTP_PORT=8080
API_JWT_SIGNING_SECRET=change-me-api-jwt-secret-min-32-chars
API_ACCESS_TOKEN_TTL_SECONDS=300
API_REFRESH_TOKEN_TTL_SECONDS=604800
API_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:4173,http://localhost:4173,http://127.0.0.1:4174,http://localhost:4174
API_RATE_LIMIT_PER_MINUTE=120
# 32 bytes / 64 hex chars. Generate with: openssl rand -hex 32
# Envelope-encrypts per-session E2EE media keys at rest (internal/e2ee).
# In production this must come from a real KMS/secrets manager, not a
# static env var.
API_E2EE_MASTER_KEY_HEX=change-me-64-hex-characters-0000000000000000000000000000000000
# Shared secret the AI agent (Day 5) presents to authenticate itself to
# the internal AI-agent-authorization endpoint. Never given to patient/
# doctor clients.
AI_AGENT_SERVICE_SECRET=change-me-ai-agent-service-secret

# --- AI Agent (Python/FastAPI) ---
AI_AGENT_HTTP_PORT=8090
# The Go session API. The agent authenticates to it with
# AI_AGENT_SERVICE_SECRET (above) — it never holds LIVEKIT_API_KEY/SECRET
# directly and never mints its own LiveKit tokens; every join goes through
# POST /internal/ai-agent/sessions/{id}/authorize, consent-gated on the Go
# side. LIVEKIT_URL (defined above, under LiveKit) is reused directly.
API_BASE_URL=http://api:8080
AI_AGENT_STT_PROVIDER=faster-whisper
AI_AGENT_TRANSLATION_PROVIDER=indictrans2
AI_AGENT_TTS_PROVIDER=stub
AI_AGENT_VAD_PROVIDER=silero
AI_AGENT_DEVICE=cpu
AI_AGENT_MODEL_CACHE_DIR=/models
# Day 6: set to true to load the real VAD/STT/translation/TTS pipeline
# (several GB of model weights). false (default) keeps the agent at Day 5
# behavior — real encrypted join/subscribe, lifecycle tracking, but no
# audio processing. See apps/ai-agent/requirements-pipeline.txt.
AI_AGENT_ENABLE_PIPELINE=false
AI_AGENT_WHISPER_MODEL_SIZE=tiny

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAME=ayureze-telehealth
PROMETHEUS_HTTP_PORT=9090
GRAFANA_HTTP_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana-password
LOKI_HTTP_PORT=3100
SENTRY_DSN=

# --- Multi-tenancy defaults (dev only) ---
DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000001
DEFAULT_TENANT_NAME=ayureze-dev
