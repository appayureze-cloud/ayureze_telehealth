# Copy to .env and fill in. Isolated from the root telehealth repo's own
# .env — see docs/ARCHITECTURE.md section 3.

TERMINOLOGY_ENVIRONMENT=development
TERMINOLOGY_LOG_LEVEL=info
TERMINOLOGY_HTTP_PORT=8100

TERMINOLOGY_POSTGRES_DB=ayureze_terminology
TERMINOLOGY_POSTGRES_USER=terminology
TERMINOLOGY_POSTGRES_PASSWORD=change-me
TERMINOLOGY_POSTGRES_PORT=5433

TERMINOLOGY_DATABASE_URL=postgresql+psycopg://terminology:change-me@localhost:5433/ayureze_terminology

TERMINOLOGY_MAX_QUERY_LENGTH=200
TERMINOLOGY_RATE_LIMIT_PER_MINUTE=120

# Only set this to "host" in an environment whose outbound HTTPS proxy
# binds to host-local loopback (unreachable from a container's isolated
# network namespace) — e.g. this sandbox's TLS-intercepting proxy at
# 127.0.0.1, see /root/.ccr/README.md. Leave unset (defaults to "default",
# normal bridge build networking) everywhere else, including CI: Docker
# Buildx treats a literal `network: host` as a privileged entitlement a
# GitHub Actions runner does not grant to `docker compose build`, and the
# build fails outright if it's requested there.
# TERMINOLOGY_BUILD_NETWORK=host
